# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development
# All NEXT_PUBLIC_* variables are exposed to the browser
# =============================================================================
#
# LEGEND:
#   [REQUIRED] - Must be set for the application to start
#   [OPTIONAL] - Has a default value or is not critical for basic operation
#   [SECRET]   - Sensitive value, never commit to version control
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application Metadata
# -----------------------------------------------------------------------------
# These variables identify the running application instance

# [OPTIONAL] Application version - set during build/deploy
# Default: "0.0.0-dev"
APP_VERSION=0.0.0-dev

# [OPTIONAL] Unique build identifier - set by CI/CD pipeline
# Default: "local"
BUILD_ID=local

# [REQUIRED] Node environment
# Values: development, production, test
# Default: production
NODE_ENV=production

# [OPTIONAL] Logging verbosity level
# Values: error, warn, info, debug
# Default: info (production), debug (development)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Firebase Client Configuration (Public)
# -----------------------------------------------------------------------------
# [REQUIRED] These are safe to expose to the client as they identify your Firebase project
# Get these values from Firebase Console > Project Settings > General

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# [OPTIONAL] Firebase Measurement ID for Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-side only)
# -----------------------------------------------------------------------------
# [REQUIRED][SECRET] Keep this secret! Never expose to the client.
# Get this from Firebase Console > Project Settings > Service Accounts
# Generate a new private key and stringify the JSON

# Option 1: JSON string (escape quotes and newlines)
FIREBASE_ADMIN_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option 2: Path to service account file (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# NextAuth.js Configuration
# -----------------------------------------------------------------------------
# [REQUIRED][SECRET] Required for NextAuth.js authentication
# Generate secret: openssl rand -base64 32

NEXTAUTH_SECRET=your_nextauth_secret_here

# [REQUIRED] The canonical URL of your site (used for callbacks and redirects)
# In production, set to your actual domain
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional: Database Configuration (if using external database)
# -----------------------------------------------------------------------------
# [OPTIONAL][SECRET] External database connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# -----------------------------------------------------------------------------
# Optional: Additional Services
# -----------------------------------------------------------------------------
# [OPTIONAL][SECRET] Redis cache connection
# REDIS_URL=redis://localhost:6379

# [OPTIONAL][SECRET] Email/SMTP configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
